# Local simulation of the three-host HA topology — `make mh-ha-up`.
#
# Same idea and same caveats as sim.env: three Compose projects, three isolated
# Docker networks, node identity carried by the port because Docker Desktop
# containers cannot reach this Mac's LAN IP. On real hosts the addresses differ
# and every port below returns to its natural value.
#
# Layout differs from sim.env, and deliberately:
#   node A   kafka1, redis primary, sentinel 1, zk 1, MinIO
#   node B   kafka2, redis replica,  sentinel 2, zk 2, JobManager (active)
#   node C   kafka3,                 sentinel 3, zk 3, JobManager (standby),
#                                                      TaskManager
#
# The active JobManager is NOT on the node holding the checkpoint store. If it
# were, killing it would also destroy what the standby recovers from, and the
# drill would prove nothing.
NODE_A_HOST=host.docker.internal
NODE_B_HOST=host.docker.internal
NODE_C_HOST=host.docker.internal

# --- node A ----------------------------------------------------------------
KAFKA_A_BROKER_PORT=19092
KAFKA_A_CTRL_PORT=19093
KAFKA_A_HOST_PORT=19094
REDIS_A_PORT=16379
SENTINEL_A_PORT=16380
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
ZK_A_CLIENT_PORT=12181
ZK_A_PEER_PORT=12888
ZK_A_ELECT_PORT=13888

# --- node B (active JobManager) --------------------------------------------
KAFKA_B_BROKER_PORT=19192
KAFKA_B_CTRL_PORT=19193
KAFKA_B_HOST_PORT=19194
REDIS_B_PORT=16479
SENTINEL_B_PORT=16480
ZK_B_CLIENT_PORT=12281
ZK_B_PEER_PORT=12988
ZK_B_ELECT_PORT=13988
TM_B_RPC_PORT=16122
TM_B_DATA_PORT=16121
TM_B_METRICS_PORT=19251
# Published 1:1 — see the comment on the jobmanager service. The two
# JobManagers BIND different ports rather than sharing one and remapping,
# because blob.server.port advertises whatever it binds.
JM_B_REST_PORT=8081
JM_B_RPC_PORT=6123
JM_B_BLOB_PORT=6124
JM_B_METRICS_PORT=9250

# --- node C (standby JobManager + the TaskManager) -------------------------
KAFKA_C_BROKER_PORT=19292
KAFKA_C_CTRL_PORT=19293
KAFKA_C_HOST_PORT=19294
SENTINEL_C_PORT=16580
ZK_C_CLIENT_PORT=12381
ZK_C_PEER_PORT=13088
ZK_C_ELECT_PORT=14088
JM_C_REST_PORT=8082
JM_C_RPC_PORT=6223
JM_C_BLOB_PORT=6224
JM_C_METRICS_PORT=9260
TM_C_RPC_PORT=16222
TM_C_DATA_PORT=16221
TM_C_METRICS_PORT=19252

# --- credentials (dev defaults; a real deployment injects these) ------------
CLUSTER_ID=petafs-mh-cluster-1
KAFKA_USER=petafs
KAFKA_PASSWORD=petafs-dev-secret
REDIS_PASSWORD=petafs-dev-secret
TLS_STOREPASS=petafs-dev-secret
MINIO_USER=petafs
MINIO_PASSWORD=petafs-dev-secret
